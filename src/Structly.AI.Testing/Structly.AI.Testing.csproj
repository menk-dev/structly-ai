<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Structly.AI.Testing</PackageId>
    <Authors>menk-dev</Authors>
    <Description>Typed, structured LLM output for automated .NET workflows.</Description>
    <PackageTags>llm;structured-output;automation;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/menk-dev/structly-ai</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/menk-dev/structly-ai</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Structly.AI/Output/FormatRules.cs" Link="Schema/FormatRules.cs" />
    <Compile Include="../Structly.AI/Output/SchemaNumbers.cs" Link="Schema/SchemaNumbers.cs" />
    <ProjectReference Include="../Structly.AI/Structly.AI.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
